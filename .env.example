# All credentials stay on the server. Never commit actual keys or paste them into chat.
# Optional financial data provider credential; current default data needs no key.
FUYAO_API_KEY=

# Optional provider-neutral chat-completions protocol.
# All three values are required. There is no default service, URL or model.
# AI_BASE_URL is the HTTPS API base path BEFORE /chat/completions.
# The provider must support messages + response_format:json_object.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
